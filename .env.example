# WorkOS AuthKit — server-side secrets. Never prefix these with PUBLIC_.
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_test_...
WORKOS_REDIRECT_URI=http://localhost:4321/callback
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-characters

# Base URL for the TrueExit API Worker. Local example assumes the API listens on port 8081.
TRUEEXIT_API_BASE_URL=http://127.0.0.1:8081
