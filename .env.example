# Server-only URL for the TrueExit API edge gateway.
# Local default gateway: http://127.0.0.1:8787/api/v1
TRUEEXIT_API_BASE_URL=http://127.0.0.1:8787/api/v1

# WorkOS AuthKit (server-only; never prefix these with PUBLIC_).
# Register http://localhost:4321/callback as a Redirect URI in WorkOS.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=sk_test_replace_me
WORKOS_REDIRECT_URI=http://localhost:4321/callback
# Generate a unique secret of at least 32 characters: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=replace_with_a_unique_secret_at_least_32_characters
