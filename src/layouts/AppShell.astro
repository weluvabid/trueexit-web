---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · TrueExit</title>
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('trueexit-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle(
            'dark',
            savedTheme ? savedTheme === 'dark' : prefersDark
          );
        } catch {
          document.documentElement.classList.toggle(
            'dark',
            window.matchMedia('(prefers-color-scheme: dark)').matches
          );
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only z-50 rounded-md bg-background px-4 py-2 text-sm font-medium text-foreground shadow focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to content
    </a>

    <div class="min-h-dvh lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]">
      <aside class="hidden border-r bg-sidebar text-sidebar-foreground lg:fixed lg:inset-y-0 lg:flex lg:w-60 lg:flex-col">
        <div class="flex h-16 items-center gap-3 border-b px-5">
          <div
            class="flex size-8 items-center justify-center rounded-lg bg-primary text-primary-foreground"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4"
            >
              <path d="M3 12h4l3-8 4 16 3-8h4" />
            </svg>
          </div>
          <span class="font-semibold tracking-tight">TrueExit</span>
        </div>

        <nav aria-label="Main navigation" class="flex-1 space-y-1 p-3">
          <a
            href="/"
            aria-current="page"
            class="flex min-h-10 items-center gap-3 rounded-md bg-sidebar-accent px-3 text-sm font-medium text-sidebar-accent-foreground"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 shrink-0"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="7" height="9" rx="1" />
              <rect x="14" y="3" width="7" height="5" rx="1" />
              <rect x="14" y="12" width="7" height="9" rx="1" />
              <rect x="3" y="16" width="7" height="5" rx="1" />
            </svg>
            Overview
          </a>
          <button
            type="button"
            disabled
            title="Available in a later build slice"
            class="flex min-h-10 w-full cursor-not-allowed items-center gap-3 rounded-md px-3 text-left text-sm text-muted-foreground opacity-60"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 shrink-0"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <path d="M7 8h10M7 12h6M7 16h4" />
            </svg>
            Monitors
          </button>
          <button
            type="button"
            disabled
            title="Available in a later build slice"
            class="flex min-h-10 w-full cursor-not-allowed items-center gap-3 rounded-md px-3 text-left text-sm text-muted-foreground opacity-60"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 shrink-0"
              aria-hidden="true"
            >
              <path d="M12 3v18M3 12h18" />
              <circle cx="12" cy="12" r="8" />
            </svg>
            Templates
          </button>
          <button
            type="button"
            disabled
            title="Available in a later build slice"
            class="flex min-h-10 w-full cursor-not-allowed items-center gap-3 rounded-md px-3 text-left text-sm text-muted-foreground opacity-60"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 shrink-0"
              aria-hidden="true"
            >
              <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
            </svg>
            Notifications
          </button>
        </nav>

        <div class="border-t p-3">
          <div class="flex items-center gap-3 rounded-md px-3 py-2 text-sm text-muted-foreground">
            <div
              class="flex size-8 items-center justify-center rounded-full border bg-background text-xs font-semibold text-foreground"
              aria-hidden="true"
            >
              TE
            </div>
            <div class="min-w-0">
              <p class="truncate font-medium text-foreground">Workspace</p>
              <p class="text-xs">Account controls arrive later</p>
            </div>
          </div>
        </div>
      </aside>

      <div class="flex min-h-dvh min-w-0 flex-col lg:col-start-2 lg:pl-60">
        <header class="sticky top-0 z-30 flex h-14 items-center justify-between border-b bg-background/95 px-4 backdrop-blur supports-[backdrop-filter]:bg-background/80 sm:px-6 lg:h-16 lg:px-8">
          <div class="flex min-w-0 items-center gap-3 lg:hidden">
            <div
              class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4"
              >
                <path d="M3 12h4l3-8 4 16 3-8h4" />
              </svg>
            </div>
            <span class="truncate font-semibold tracking-tight">TrueExit</span>
          </div>
          <div class="hidden text-sm text-muted-foreground lg:block">Workspace</div>
          <div class="ml-auto flex items-center gap-2">
            <button
              id="theme-toggle"
              type="button"
              aria-label="Switch to dark mode"
              title="Toggle theme"
              class="inline-flex size-9 items-center justify-center rounded-md border border-transparent text-foreground transition-colors hover:border-border hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              <svg
                id="theme-icon-sun"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5"
              >
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
              </svg>
              <svg
                id="theme-icon-moon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="hidden size-5"
              >
                <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
              </svg>
            </button>
          </div>
        </header>

        <main
          id="main-content"
          class="w-full flex-1 px-4 py-6 pb-24 sm:px-6 sm:py-8 lg:px-8 lg:py-10 lg:pb-10"
        >
          <slot />
        </main>

        <nav
          aria-label="Mobile navigation"
          class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-4 border-t bg-background/95 px-1 pb-[env(safe-area-inset-bottom)] pt-1 backdrop-blur lg:hidden"
        >
          <a
            href="/"
            aria-current="page"
            class="flex min-h-14 flex-col items-center justify-center gap-1 rounded-md text-primary"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="7" height="9" rx="1" />
              <rect x="14" y="3" width="7" height="5" rx="1" />
              <rect x="14" y="12" width="7" height="9" rx="1" />
              <rect x="3" y="16" width="7" height="5" rx="1" />
            </svg>
            <span class="text-[11px] font-medium">Overview</span>
          </a>
          <button
            type="button"
            disabled
            aria-label="Monitors, available in a later build slice"
            class="flex min-h-14 flex-col items-center justify-center gap-1 rounded-md text-muted-foreground opacity-50"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <path d="M7 8h10M7 12h6M7 16h4" />
            </svg>
            <span class="text-[11px]">Monitors</span>
          </button>
          <button
            type="button"
            disabled
            aria-label="Evidence, available in a later build slice"
            class="flex min-h-14 flex-col items-center justify-center gap-1 rounded-md text-muted-foreground opacity-50"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
              <path d="M14 2v6h6M8 13h8M8 17h8" />
            </svg>
            <span class="text-[11px]">Evidence</span>
          </button>
          <button
            type="button"
            disabled
            aria-label="Settings, available in a later build slice"
            class="flex min-h-14 flex-col items-center justify-center gap-1 rounded-md text-muted-foreground opacity-50"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="3" />
              <path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.7a8 8 0 0 1-1.8 1l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.8-1l-1.7.7-1.4-2.4L7.1 15a8 8 0 0 1 0-2l-1.4-1.1 1.4-2.4 1.7.7a8 8 0 0 1 1.8-1l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.8 1l1.7-.7 1.4 2.4-1.4 1.1a8 8 0 0 1-.1 2Z" />
            </svg>
            <span class="text-[11px]">Settings</span>
          </button>
        </nav>
      </div>
    </div>

    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const sunIcon = document.querySelector<SVGElement>('#theme-icon-sun');
      const moonIcon = document.querySelector<SVGElement>('#theme-icon-moon');

      function syncThemeButton() {
        const isDark = document.documentElement.classList.contains('dark');
        themeToggle?.setAttribute(
          'aria-label',
          isDark ? 'Switch to light mode' : 'Switch to dark mode'
        );
        sunIcon?.classList.toggle('hidden', isDark);
        moonIcon?.classList.toggle('hidden', !isDark);
      }

      themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('trueexit-theme', isDark ? 'dark' : 'light');
        } catch {
          // Theme switching still works for this session when storage is unavailable.
        }
        syncThemeButton();
      });

      syncThemeButton();
    </script>
  </body>
</html>
