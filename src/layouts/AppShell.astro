---
import BrandMark from '../components/BrandMark.astro';
import AppNavigation from '../components/AppNavigation.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Clear signals, fewer surprises.' } = Astro.props;
const { auth } = Astro.locals;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f8fa" />
    <meta name="description" content={description} />
    <title>{title} · TrueExit</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-frame">
      <header class="app-header">
        <div class="app-header__inner">
          <BrandMark />
          <AppNavigation />
          <div class="app-header__right" aria-label="Account area">
            <span class="header-status"><span aria-hidden="true"></span>Monitoring, made clear</span>
            <span class="account-email" title={auth.user?.email ?? 'Authenticated account'}>{auth.user?.email ?? 'Signed in'}</span>
            <a class="sign-out-link" href="/logout">Sign out</a>
          </div>
        </div>
      </header>
      <main id="main-content" class="app-main">
        <slot />
      </main>
      <div class="mobile-nav-wrap"><AppNavigation /></div>
    </div>
  </body>
</html>
