---
import BrandMark from '../components/BrandMark.astro';
import AppNavigation from '../components/AppNavigation.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Clear signals, fewer surprises.' } = Astro.props;
const { auth } = Astro.locals;
const email = auth.user?.email ?? 'Signed in';
const initials = email === 'Signed in' ? 'TE' : email.split('@')[0].split(/[._-]/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase() || 'TE';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f6f6f9" data-theme-color />
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        try {
          const preference = localStorage.getItem('trueexit.appearance') || 'system';
          const resolved = preference === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : preference;
          document.documentElement.dataset.theme = resolved;
          document.documentElement.dataset.themePreference = preference;
          document.querySelector('[data-theme-color]')?.setAttribute('content', resolved === 'dark' ? '#09090d' : '#f6f6f9');
        } catch {
          document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.themePreference = 'system';
        }
      })();
    </script>
    <style is:global>
      /* Theme icons use an explicit class state, not the HTML hidden attribute. */
      .theme-icon {
        display: none !important;
      }
      .theme-icon.is-active {
        display: block !important;
      }
    </style>
    <title>{title} · TrueExit</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-frame">
      <header class="app-header" data-app-header>
        <div class="app-header__inner">
          <div class="app-header__identity">
            <BrandMark showWordmark={false} />
            <div class="workspace-switcher" data-workspace-switcher>
              <button class="workspace-switcher__trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="workspace-options" data-workspace-trigger disabled>
                <span class="workspace-switcher__name" data-workspace-name>Loading workspace…</span>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4" /></svg>
              </button>
              <div class="workspace-switcher__menu" id="workspace-options" role="listbox" aria-label="Switch workspace" hidden data-workspace-options>
                <div class="workspace-switcher__heading">Switch workspace</div>
                <div class="workspace-switcher__items" data-workspace-items></div>
                <p class="workspace-switcher__message" data-workspace-message hidden></p>
              </div>
            </div>

            <button class="icon-button search-trigger" type="button" aria-label="Quick navigation" title="Quick navigation (⌘K)" data-search-open>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5" /><path d="m16 16 4.2 4.2" /></svg>
              <span class="search-trigger__hint" aria-hidden="true">⌘ K</span>
            </button>
          </div>

          <div class="app-header__navigation"><AppNavigation /></div>

          <div class="app-header__utilities" aria-label="Application utilities">
            <button class="icon-button theme-toggle" type="button" aria-label="Appearance: System. Switch to light mode" title="Appearance: System · click for light mode" data-theme-toggle>
              <svg class="theme-icon is-active" data-theme-icon="system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
              <svg class="theme-icon" data-theme-icon="light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
              <svg class="theme-icon" data-theme-icon="dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.6 8.6 0 1 0 20.5 14.2Z"/></svg>
            </button>
            <div class="account-menu" data-account-menu>
              <button class="account-menu__trigger" type="button" aria-label="Open account menu" aria-haspopup="true" aria-expanded="false" data-account-trigger>
                <span class="account-avatar" aria-hidden="true">{initials}</span>
              </button>
              <div class="account-menu__panel" hidden data-account-panel>
                <div class="account-menu__identity">
                  <span class="account-avatar account-avatar--large" aria-hidden="true">{initials}</span>
                  <span class="account-menu__email" title={email}>{email}</span>
                </div>
                <div class="account-menu__divider"></div>
                <a class="account-menu__item" href="/account">Account settings <span aria-hidden="true">↗</span></a>
                <a class="account-menu__item account-menu__item--signout" href="/logout">Sign out <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </div>
        </div>
      </header>
      <main id="main-content" class="app-main">
        <slot />
      </main>
      <footer class="app-footer">
        <BrandMark compact showWordmark={false} />
        <span>Clear signals, fewer surprises.</span>
      </footer>
      <div class="mobile-nav-wrap" aria-label="Mobile navigation"><AppNavigation /></div>
    </div>

    <dialog class="search-dialog" aria-labelledby="search-dialog-title" data-search-dialog>
      <div class="search-dialog__topline">
        <h2 id="search-dialog-title">Quick navigation</h2>
        <button class="search-dialog__close" type="button" aria-label="Close search" data-search-close>Esc</button>
      </div>
      <label class="search-dialog__field">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5" /><path d="m16 16 4.2 4.2" /></svg>
        <input type="search" placeholder="Filter destinations…" autocomplete="off" data-search-input />
      </label>
      <section class="search-dialog__navigation-section" data-search-navigation-section>
      <p class="search-dialog__label">NAVIGATION</p>
      <div class="search-dialog__results" data-search-results>
        <a href="/" data-search-item data-search-terms="overview dashboard home"><span class="search-dialog__result-icon">◫</span><span>Overview</span><kbd>O</kbd></a>
        <a href="/monitors" data-search-item data-search-terms="monitors monitor checks"><span class="search-dialog__result-icon">⌁</span><span>Monitors</span><kbd>M</kbd></a>
        <a href="/settings" data-search-item data-search-terms="settings workspace members channels"><span class="search-dialog__result-icon">⚙</span><span>Settings</span><kbd>S</kbd></a>
        <a href="/templates" data-search-item data-search-terms="templates global library"><span class="search-dialog__result-icon">▤</span><span>Templates</span><kbd>T</kbd></a>
      </div>
      </section>
      <section class="search-dialog__workspace-results" data-workspace-search-section hidden aria-live="polite">
        <p class="search-dialog__label">WORKSPACE RESULTS</p>
        <div class="search-dialog__results" data-workspace-search-results></div>
        <p class="search-dialog__status" data-workspace-search-status hidden></p>
      </section>
      <p class="search-dialog__empty" hidden data-search-empty>No matching destinations.</p>
      <div class="search-dialog__footer"><span>Navigate to a destination</span><span><kbd>↑</kbd> <kbd>↓</kbd> select <kbd>↵</kbd> open</span></div>
    </dialog>

    <script>
      import { loadWorkspaceBootstrap } from '../lib/client/workspace-bootstrap';
      import { fetchSharedGet } from '../lib/client/shared-http-query';
      import { readActiveWorkspaceId, writeActiveWorkspaceId, resolveWorkspaceId } from '../lib/client/workspace-preference';

      (() => {
        const header = document.querySelector('[data-app-header]');
        const workspaceTrigger = document.querySelector('[data-workspace-trigger]');
        const workspaceOptions = document.querySelector('[data-workspace-options]');
        const workspaceName = document.querySelector('[data-workspace-name]');
        const workspaceItems = document.querySelector('[data-workspace-items]');
        const workspaceMessage = document.querySelector('[data-workspace-message]');
        const accountTrigger = document.querySelector('[data-account-trigger]');
        const accountPanel = document.querySelector('[data-account-panel]');
        const searchDialog = document.querySelector('[data-search-dialog]');
        const searchInput = document.querySelector('[data-search-input]');
        const searchOpen = document.querySelector('[data-search-open]');
        const themeToggle = document.querySelector('[data-theme-toggle]');
        const themeColor = document.querySelector('[data-theme-color]');
        const themeIcons = [...document.querySelectorAll('[data-theme-icon]')];
        const THEME_KEY = 'trueexit.appearance';
        const themeOrder = ['light', 'dark', 'system'];
        const themeLabels = { system: 'System', light: 'Light', dark: 'Dark' };

        function applyTheme(preference, persist = true) {
          const resolved = preference === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : preference;
          document.documentElement.dataset.theme = resolved;
          document.documentElement.dataset.themePreference = preference;
          document.documentElement.style.colorScheme = resolved;
          themeColor?.setAttribute('content', resolved === 'dark' ? '#09090d' : '#f6f6f9');
          themeIcons.forEach((icon) => { icon.classList.toggle('is-active', icon.dataset.themeIcon === preference); });
          const next = themeOrder[(themeOrder.indexOf(preference) + 1) % themeOrder.length];
          const description = `Appearance: ${themeLabels[preference]}. Switch to ${next === 'system' ? 'system appearance' : `${next} mode`}`;
          themeToggle?.setAttribute('aria-label', description);
          themeToggle?.setAttribute('title', description);
          if (persist) { try { localStorage.setItem(THEME_KEY, preference); } catch { /* Preference still applies for this page. */ } }
        }
        let themePreference = document.documentElement.dataset.themePreference || 'system';
        applyTheme(themePreference, false);
        themeToggle?.addEventListener('click', () => {
          themePreference = themeOrder[(themeOrder.indexOf(themePreference) + 1) % themeOrder.length];
          applyTheme(themePreference);
        });
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change', () => {
          if (themePreference === 'system') applyTheme('system', false);
        });
        const searchClose = document.querySelector('[data-search-close]');
        const searchItems = [...document.querySelectorAll('[data-search-item]')];
        const searchEmpty = document.querySelector('[data-search-empty]');
        const searchNavigationSection = document.querySelector('[data-search-navigation-section]');
        const workspaceSearchSection = document.querySelector('[data-workspace-search-section]');
        const workspaceSearchResults = document.querySelector('[data-workspace-search-results]');
        const workspaceSearchStatus = document.querySelector('[data-workspace-search-status]');
        let searchTimer;
        let searchRequestSequence = 0;
        let workspaces = [];
        let activeWorkspaceId = '';

        const closeWorkspaceMenu = () => {
          workspaceOptions.hidden = true;
          workspaceTrigger.setAttribute('aria-expanded', 'false');
          ['left', 'top', 'width', 'max-height'].forEach((property) => workspaceOptions.style.removeProperty(property));
        };
        function positionWorkspaceMenu() {
          if (workspaceOptions.hidden) return;
          const triggerRect = workspaceTrigger.getBoundingClientRect();
          const viewportWidth = document.documentElement.clientWidth;
          const viewportHeight = window.innerHeight;
          const mobile = window.matchMedia('(max-width: 760px)').matches;
          const gutter = 12;
          const width = mobile ? Math.max(0, viewportWidth - gutter * 2) : Math.min(380, viewportWidth - gutter * 2);
          const left = mobile ? gutter : Math.max(gutter, Math.min(triggerRect.left, viewportWidth - width - gutter));
          const estimatedHeight = Math.min(workspaceOptions.scrollHeight || 220, viewportHeight - gutter * 2);
          let top = triggerRect.bottom + 8;
          if (top + estimatedHeight > viewportHeight - gutter && triggerRect.top - estimatedHeight - 8 >= gutter) top = triggerRect.top - estimatedHeight - 8;
          top = Math.max(gutter, Math.min(top, viewportHeight - gutter - Math.min(estimatedHeight, viewportHeight - gutter * 2)));
          workspaceOptions.style.left = `${left}px`;
          workspaceOptions.style.top = `${top}px`;
          workspaceOptions.style.width = `${width}px`;
          workspaceOptions.style.maxHeight = `${Math.max(120, viewportHeight - top - gutter)}px`;
        }
        const closeAccountMenu = () => {
          accountPanel.hidden = true;
          accountTrigger.setAttribute('aria-expanded', 'false');
        };
        const closeMenus = () => { closeWorkspaceMenu(); closeAccountMenu(); };

        function chooseWorkspace(id) {
          const next = workspaces.find((workspace) => workspace.id === id);
          if (!next || id === activeWorkspaceId) { closeWorkspaceMenu(); return; }
          const confirmed = window.confirm(`Switch to “${next.name}”? This reloads the current page, so any unsaved changes may be lost.`);
          if (!confirmed) return;
          writeActiveWorkspaceId(id);
          const url = new URL(window.location.href);
          if (url.pathname.startsWith('/monitors/')) url.searchParams.set('workspace_id', id);
          else url.searchParams.delete('workspace_id');
          window.location.assign(url.toString());
        }

        function renderWorkspaces() {
          workspaceItems.replaceChildren();
          if (!workspaces.length) {
            workspaceName.textContent = 'No workspace';
            workspaceTrigger.disabled = true;
            workspaceMessage.hidden = false;
            workspaceMessage.textContent = 'No accessible workspace was returned for this account.';
            return;
          }
          workspaceTrigger.disabled = false;
          const active = workspaces.find((workspace) => workspace.id === activeWorkspaceId) || workspaces[0];
          activeWorkspaceId = active.id;
          workspaceName.textContent = active.name;
          workspaces.forEach((workspace) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'workspace-switcher__option';
            button.setAttribute('role', 'option');
            button.setAttribute('aria-selected', String(workspace.id === activeWorkspaceId));
            button.innerHTML = '<span class="workspace-switcher__option-mark" aria-hidden="true"></span><span class="workspace-switcher__option-copy"></span><span class="workspace-switcher__option-check" aria-hidden="true">✓</span>';
            button.querySelector('.workspace-switcher__option-copy').textContent = workspace.name + (workspace.personal ? ' · Personal' : '');
            button.addEventListener('click', () => chooseWorkspace(workspace.id));
            workspaceItems.append(button);
          });
        }

        workspaceTrigger.addEventListener('click', () => {
          const opening = workspaceOptions.hidden;
          closeMenus();
          workspaceOptions.hidden = !opening;
          workspaceTrigger.setAttribute('aria-expanded', String(opening));
          if (opening) {
            positionWorkspaceMenu();
            workspaceItems.querySelector('[aria-selected="true"]')?.focus();
          }
        });
        workspaceTrigger.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' && workspaceOptions.hidden) { event.preventDefault(); workspaceTrigger.click(); }
        });
        workspaceItems.addEventListener('keydown', (event) => {
          const options = [...workspaceItems.querySelectorAll('[role="option"]')];
          const index = options.indexOf(document.activeElement);
          if (event.key === 'ArrowDown' && options.length) { event.preventDefault(); options[(index + 1 + options.length) % options.length].focus(); }
          if (event.key === 'ArrowUp' && options.length) { event.preventDefault(); if (index <= 0) workspaceTrigger.focus(); else options[index - 1].focus(); }
          if (event.key === 'Home' && options.length) { event.preventDefault(); options[0].focus(); }
          if (event.key === 'End' && options.length) { event.preventDefault(); options[options.length - 1].focus(); }
        });
        accountTrigger.addEventListener('click', () => {
          const opening = accountPanel.hidden;
          closeMenus();
          accountPanel.hidden = !opening;
          accountTrigger.setAttribute('aria-expanded', String(opening));
        });
        document.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (!target?.closest('[data-workspace-switcher]')) closeWorkspaceMenu();
          if (!target?.closest('[data-account-menu]')) closeAccountMenu();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') { closeMenus(); if (searchDialog.open) searchDialog.close(); }
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault(); if (!searchDialog.open) searchDialog.showModal(); searchInput.focus();
          }
        });
        window.addEventListener('scroll', () => {
          header.classList.toggle('is-scrolled', window.scrollY > 8);
          positionWorkspaceMenu();
        }, { passive: true });
        window.addEventListener('resize', positionWorkspaceMenu, { passive: true });

        function updateSearch() {
          const rawQuery = searchInput.value.trim();
          const query = rawQuery.toLowerCase();
          let visible = 0;
          searchItems.forEach((item) => {
            const matches = !query || (item.dataset.searchTerms + ' ' + item.textContent).toLowerCase().includes(query);
            item.hidden = !matches;
            if (matches) visible += 1;
          });
          searchNavigationSection.hidden = visible === 0;
          searchEmpty.hidden = visible > 0 || rawQuery.length > 0;
          workspaceSearchSection.hidden = rawQuery.length < 2;
          workspaceSearchResults.replaceChildren();
          workspaceSearchStatus.hidden = true;
          workspaceSearchSection.querySelector('.search-dialog__label').hidden = false;
          if (searchTimer) clearTimeout(searchTimer);
          const sequence = ++searchRequestSequence;
          if (rawQuery.length >= 2) {
            workspaceSearchStatus.hidden = false;
            workspaceSearchStatus.textContent = 'Searching this workspace…';
            searchTimer = setTimeout(() => void searchWorkspace(rawQuery, sequence), 220);
          }
        }

        function appendWorkspaceResult(label, detail, href, icon) {
          const link = document.createElement('a');
          link.href = href;
          link.innerHTML = '<span class="search-dialog__result-icon" aria-hidden="true"></span><span class="search-dialog__result-copy"><strong></strong><small></small></span><span class="search-dialog__result-arrow" aria-hidden="true">↗</span>';
          link.querySelector('.search-dialog__result-icon').textContent = icon;
          link.querySelector('strong').textContent = label;
          link.querySelector('small').textContent = detail || '';
          workspaceSearchResults.append(link);
        }

        async function searchWorkspace(query, sequence) {
          const workspaceId = activeWorkspaceId || readActiveWorkspaceId();
          if (!workspaceId) {
            if (sequence === searchRequestSequence) { workspaceSearchStatus.textContent = 'Choose a workspace to search its resources.'; }
            return;
          }
          try {
            const params = new URLSearchParams({ workspace_id: workspaceId, q: query, scope: 'all', limit: '5' });
            const response = await fetchSharedGet(`/api/backend/search?${params}`, { headers: { Accept: 'application/json' }, credentials: 'same-origin', cache: 'no-store' });
            const body = await response.json().catch(() => null);
            if (sequence !== searchRequestSequence) return;
            if (!response.ok) { workspaceSearchStatus.textContent = response.status === 403 ? 'You do not have access to search this workspace.' : 'Workspace search is temporarily unavailable.'; return; }
            const groups = body?.results || {};
            let count = 0;
            for (const item of groups.monitors?.data || []) {
              appendWorkspaceResult(item.name, item.description || 'Monitor', `/monitors/${encodeURIComponent(item.id)}?workspace_id=${encodeURIComponent(workspaceId)}`, '⌁'); count++;
            }
            for (const item of groups.evidence?.data || []) {
              appendWorkspaceResult(item.monitor_name || 'Evidence', `${item.outcome || 'Evidence'} · ${item.recorded_at || ''}`, `/monitors/${encodeURIComponent(item.monitor_id)}?workspace_id=${encodeURIComponent(workspaceId)}`, '◇'); count++;
            }
            for (const item of groups.templates?.data || []) {
              appendWorkspaceResult(item.name, `${item.kind === 'built_in' ? 'Built-in template' : 'Custom template'} · v${item.version}`, `/templates`, '▤'); count++;
            }
            for (const item of groups.tags?.data || []) {
              appendWorkspaceResult(item.name, `${item.monitor_count ?? 0} monitors`, `/monitors`, '#'); count++;
            }
            workspaceSearchStatus.hidden = count > 0;
            if (count === 0) { workspaceSearchStatus.hidden = false; workspaceSearchStatus.textContent = 'No matching workspace resources.'; }
            workspaceSearchSection.querySelector('.search-dialog__label').hidden = count === 0;
          } catch {
            if (sequence === searchRequestSequence) { workspaceSearchStatus.hidden = false; workspaceSearchStatus.textContent = 'Could not reach workspace search. Try again.'; }
          }
        }
        searchOpen.addEventListener('click', () => { searchDialog.showModal(); searchInput.focus(); updateSearch(); });
        searchClose.addEventListener('click', () => searchDialog.close());
        searchDialog.addEventListener('click', (event) => { if (event.target === searchDialog) searchDialog.close(); });
        searchInput.addEventListener('input', updateSearch);
        searchInput.addEventListener('keydown', (event) => {
          const visibleItems = searchItems.filter((item) => !item.hidden);
          const focusedIndex = visibleItems.indexOf(document.activeElement);
          if (event.key === 'ArrowDown' && visibleItems.length) { event.preventDefault(); visibleItems[0].focus(); }
        });
        searchItems.forEach((item) => item.addEventListener('keydown', (event) => {
          const visibleItems = searchItems.filter((entry) => !entry.hidden);
          const index = visibleItems.indexOf(item);
          if (event.key === 'ArrowDown') { event.preventDefault(); visibleItems[(index + 1) % visibleItems.length]?.focus(); }
          if (event.key === 'ArrowUp') { event.preventDefault(); if (index === 0) searchInput.focus(); else visibleItems[index - 1]?.focus(); }
        }));
        searchDialog.addEventListener('close', () => { searchRequestSequence += 1; if (searchTimer) clearTimeout(searchTimer); searchOpen.focus(); });

        async function bootstrapWorkspace() {
          try {
            // Use the same bootstrap loader as hydrated workspaces. Its per-document
            // promise and shared GET layer prevent the shell from duplicating reads.
            const result = await loadWorkspaceBootstrap();
            if (!result.workspaces.ok) throw new Error('workspace_load_failed');
            const availableWorkspaces = result.workspaces.data.data;
            const me = result.me.ok ? result.me.data : null;
            workspaces = availableWorkspaces;
            const requested = new URLSearchParams(window.location.search).get('workspace_id');
            const stored = readActiveWorkspaceId();
            activeWorkspaceId = resolveWorkspaceId(workspaces, [requested, stored, me?.personal_workspace_id]);
            renderWorkspaces();
            if (activeWorkspaceId && stored !== activeWorkspaceId) writeActiveWorkspaceId(activeWorkspaceId);
          } catch {
            workspaceName.textContent = 'Workspace unavailable';
            workspaceTrigger.disabled = true;
            workspaceMessage.hidden = false;
            workspaceMessage.textContent = 'Could not load workspaces. Refresh to try again.';
          }
        }
        void bootstrapWorkspace();
      })();
    </script>
  </body>
</html>
