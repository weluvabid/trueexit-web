---
import BrandMark from '../components/BrandMark.astro';
import AppNavigation from '../components/AppNavigation.astro';
import AppShellControls from '../components/AppShellControls.svelte';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  layout?: 'compact' | 'standard' | 'comfortable';
}

const { title, description = 'Clear signals, fewer surprises.', layout = 'comfortable' } = Astro.props;
const { auth } = Astro.locals;
const email = auth.user?.email ?? 'Signed in';
const initials = email === 'Signed in' ? 'TE' : email.split('@')[0].split(/[._-]/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase() || 'TE';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" data-theme-color data-light-color="#ffffff" data-dark-color="#0a0a0a" />
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        try {
          const preference = localStorage.getItem('trueexit.appearance') || 'system';
          const resolved = preference === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : preference;
          document.documentElement.dataset.theme = resolved;
          document.documentElement.dataset.themePreference = preference;
          const themeColor = document.querySelector('[data-theme-color]');
          if (themeColor instanceof HTMLMetaElement) {
            themeColor.content = resolved === 'dark' ? themeColor.dataset.darkColor ?? '#0a0a0a' : themeColor.dataset.lightColor ?? '#ffffff';
          }
        } catch {
          document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.themePreference = 'system';
        }
      })();
    </script>
    <title>{title} · TrueExit</title>
  </head>
  <body data-query-cache-user={auth.user?.id ?? ''}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-frame">
      <header class="app-header" data-app-header>
        <div class="app-header__inner">
          <AppShellControls client:load email={email} initials={initials} />
          <div class="app-header__navigation"><AppNavigation /></div>
        </div>
      </header>
      <main id="main-content" class="app-main" data-layout={layout}>
        <slot />
      </main>
      <footer class="app-footer">
        <BrandMark compact showWordmark={false} />
        <span>Clear signals, fewer surprises.</span>
      </footer>
      <div class="mobile-nav-wrap" aria-label="Mobile navigation"><AppNavigation /></div>
    </div>


  </body>
</html>
