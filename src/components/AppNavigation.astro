---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [
  { label: 'Overview', href: '/', icon: 'overview', scope: 'workspace' },
  { label: 'Monitors', href: '/monitors', icon: 'monitors', scope: 'workspace' },
  { label: 'Settings', href: '/settings', icon: 'settings', scope: 'workspace' },
  { label: 'Templates', href: '/templates', icon: 'templates', scope: 'global' },
];
---

<nav class="app-nav" aria-label="Primary navigation">
  {items.map((item, index) => {
    const active = item.href === '/' ? currentPath === '/' : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
    return (
      <Fragment>
        {item.scope === 'global' && <span class="app-nav__separator" aria-hidden="true"></span>}
        <a
          class:list={['app-nav__link', { 'is-active': active, 'app-nav__link--global': item.scope === 'global' }]}
          href={item.href}
          aria-current={active ? 'page' : undefined}
          data-nav-scope={item.scope}
        >
          <svg class="app-nav__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            {item.icon === 'overview' && <g><rect x="3.5" y="3.5" width="7" height="7" rx="2" /><rect x="13.5" y="3.5" width="7" height="4" rx="1.5" /><rect x="13.5" y="10.5" width="7" height="10" rx="2" /><rect x="3.5" y="13.5" width="7" height="7" rx="2" /></g>}
            {item.icon === 'monitors' && <g><rect x="3" y="4" width="18" height="13" rx="2.5" /><path d="M7 21h10M12 17v4m-5-8 3-3 2 2 3-4 2 2" /></g>}
            {item.icon === 'templates' && <g><rect x="4" y="3.5" width="16" height="17" rx="2.5" /><path d="M8 8h8M8 12h8M8 16h5" /></g>}
            {item.icon === 'settings' && <g><circle cx="12" cy="12" r="3" /><path d="m19.4 15 .1.1a1.8 1.8 0 1 1-2.5 2.5l-.1-.1a1.8 1.8 0 0 0-3 .9v.2a1.8 1.8 0 1 1-3.6 0v-.2a1.8 1.8 0 0 0-3-.9l-.1.1a1.8 1.8 0 1 1-2.5-2.5l.1-.1a1.8 1.8 0 0 0-.9-3H3.7a1.8 1.8 0 1 1 0-3.6h.2a1.8 1.8 0 0 0 .9-3l-.1-.1a1.8 1.8 0 1 1 2.5-2.5l.1.1a1.8 1.8 0 0 0 3-.9v-.2a1.8 1.8 0 1 1 3.6 0v.2a1.8 1.8 0 0 0 3 .9l.1-.1a1.8 1.8 0 1 1 2.5 2.5l-.1.1a1.8 1.8 0 0 0 .9 3h.2a1.8 1.8 0 1 1 0 3.6h-.2a1.8 1.8 0 0 0-.9 3Z" /></g>}
          </svg>
          <span>{item.label}</span>
        </a>
      </Fragment>
    );
  })}
</nav>
