---
interface Props {
  compact?: boolean;
  showWordmark?: boolean;
}

const { compact = false, showWordmark = true } = Astro.props;
---

<a class:list={['brand', { 'brand--compact': compact }]} href="/" aria-label="TrueExit home">
  <svg class="brand__mark" viewBox="0 0 36 36" fill="none" aria-hidden="true">
    <path d="M25.7 8.3H13.4C8.8 8.3 5.1 12 5.1 16.6v5.1c0 3.3 2.7 6 6 6h8.4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
    <path d="M15.3 18h15.1m-6.2-6.2 6.2 6.2-6.2 6.2" stroke="url(#trueexit-mark-gradient)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    <defs>
      <linearGradient id="trueexit-mark-gradient" x1="15.3" y1="18" x2="30.4" y2="18" gradientUnits="userSpaceOnUse">
        <stop stop-color="#6558E8" />
        <stop offset="1" stop-color="#9A78F5" />
      </linearGradient>
    </defs>
  </svg>
  {showWordmark && <span class="brand__wordmark">True<span>Exit</span></span>}
</a>
