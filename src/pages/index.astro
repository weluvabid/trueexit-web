---
import AppShell from '../layouts/AppShell.astro';
import '../styles/dashboard.css';
import DashboardOverview from '../components/DashboardOverview.svelte';
const { auth } = Astro.locals;

if (!auth.user) {
  return auth.redirectToSignIn();
}
---

<AppShell title="Overview" description="A clearer view of service health, evidence, and monitoring activity.">
  <DashboardOverview client:load />


</AppShell>
