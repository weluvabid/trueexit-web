---
import AppShell from '../layouts/AppShell.astro';
const { auth } = Astro.locals;

if (!auth.user) {
  return auth.redirectToSignIn();
}
---

<AppShell title="Overview" description="A clearer view of service health, evidence, and monitoring activity.">
  <section class="page-intro">
    <div>
      <p class="eyebrow"><span class="eyebrow__dash"></span>YOUR SERVICE PICTURE</p>
      <h1>Good to have<br class="mobile-break" /> you here.</h1>
      <p class="page-intro__copy">A clear view of what’s happening, what changed, and what needs your attention.</p>
    </div>
    <a class="button button--primary" href="/monitors">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      Explore monitors
    </a>
  </section>

  <section class="welcome-panel" aria-labelledby="welcome-title">
    <div class="welcome-panel__glow" aria-hidden="true"></div>
    <div class="welcome-panel__content">
      <span class="welcome-panel__kicker"><span class="welcome-panel__spark" aria-hidden="true">✳</span> A calmer way to stay informed</span>
      <h2 id="welcome-title">Know what’s real.<br /><span>Act with confidence.</span></h2>
      <p>TrueExit connects monitor checks with the evidence behind each result, so you can understand service health without the noise.</p>
      <a class="text-link" href="/monitors">Get to know monitors <span aria-hidden="true">↗</span></a>
    </div>
    <div class="signal-art" aria-hidden="true">
      <div class="signal-art__orbit signal-art__orbit--outer"></div>
      <div class="signal-art__orbit signal-art__orbit--middle"></div>
      <div class="signal-art__orbit signal-art__orbit--inner"></div>
      <div class="signal-art__core"><svg viewBox="0 0 36 36" fill="none"><path d="M25.7 8.3H13.4C8.8 8.3 5.1 12 5.1 16.6v5.1c0 3.3 2.7 6 6 6h8.4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M15.3 18h15.1m-6.2-6.2 6.2 6.2-6.2 6.2" stroke="url(#signal-gradient)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><defs><linearGradient id="signal-gradient" x1="15" y1="18" x2="30" y2="18"><stop stop-color="#8b7dff"/><stop offset="1" stop-color="#c4a9ff"/></linearGradient></defs></svg></div>
      <span class="signal-art__spark signal-art__spark--one"></span>
      <span class="signal-art__spark signal-art__spark--two"></span>
      <span class="signal-art__spark signal-art__spark--three"></span>
    </div>
  </section>

  <section class="next-steps" aria-labelledby="next-steps-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A SIMPLE PLACE TO START</p>
        <h2 id="next-steps-title">Make it yours</h2>
      </div>
      <span class="section-heading__note">Your workspace, at your pace</span>
    </div>
    <div class="starter-grid">
      <a class="starter-card" href="/monitors">
        <span class="starter-card__icon starter-card__icon--monitor"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2.5"/><path d="M7 21h10M12 17v4m-5-8 3-3 2 2 3-4 2 2"/></svg></span>
        <span class="starter-card__title">Monitors</span>
        <span class="starter-card__copy">Define what to check and how often.</span>
        <span class="starter-card__arrow" aria-hidden="true">↗</span>
      </a>
      <a class="starter-card" href="/templates">
        <span class="starter-card__icon starter-card__icon--template"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="3.5" width="16" height="17" rx="2.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span>
        <span class="starter-card__title">Templates</span>
        <span class="starter-card__copy">Reuse field definitions when it helps.</span>
        <span class="starter-card__arrow" aria-hidden="true">↗</span>
      </a>
      <a class="starter-card" href="/settings">
        <span class="starter-card__icon starter-card__icon--settings"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1a1.8 1.8 0 1 1-2.5 2.5l-.1-.1a1.8 1.8 0 0 0-3 .9v.2a1.8 1.8 0 1 1-3.6 0v-.2a1.8 1.8 0 0 0-3-.9l-.1.1a1.8 1.8 0 1 1-2.5-2.5l.1-.1a1.8 1.8 0 0 0-.9-3H3.7a1.8 1.8 0 1 1 0-3.6h.2a1.8 1.8 0 0 0 .9-3l-.1-.1a1.8 1.8 0 1 1 2.5-2.5l.1.1a1.8 1.8 0 0 0 3-.9v-.2a1.8 1.8 0 1 1 3.6 0v.2a1.8 1.8 0 0 0 3 .9l.1-.1a1.8 1.8 0 1 1 2.5 2.5l-.1.1a1.8 1.8 0 0 0 .9 3h.2a1.8 1.8 0 1 1 0 3.6h-.2a1.8 1.8 0 0 0-.9 3Z"/></svg></span>
        <span class="starter-card__title">Settings</span>
        <span class="starter-card__copy">Workspace controls will live here.</span>
        <span class="starter-card__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</AppShell>
